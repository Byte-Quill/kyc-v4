Options -Indexes
DirectoryIndex index.php

<FilesMatch "\.(sql|md|env|sh|bak|lock|json|phar)$">
Require all denied
</FilesMatch>

# Protect the .env file explicitly (it starts with a dot).

<Files ".env">
Require all denied
</Files>

# ---------------------------------------------------------------------------
# Performance: gzip compression + browser caching.
# Keeps pages small and avoids re-downloading unchanged assets, which helps
# low-power devices and slow connections. Everything is guarded so the app
# still runs on Apache builds without these modules.
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # HTML/PHP pages are dynamic — never cache them.
    ExpiresByType text/html "access plus 0 seconds"
    # Static assets can be cached; layout.php cache-busts the stylesheet.
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|svg|webp)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # -----------------------------------------------------------------------
    # Security headers
    # -----------------------------------------------------------------------
    # Clickjacking protection
    Header always set X-Frame-Options "DENY"
    # MIME sniffing protection
    Header always set X-Content-Type-Options "nosniff"
    # Referrer policy — never leak the full URL to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Restrict browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Content Security Policy — allow same-origin scripts/styles, inline styles
    # (needed for the style="" attributes used in the app), and data: images.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
