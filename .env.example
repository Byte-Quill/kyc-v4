# ============================================================================
# KYC Verify - Environment template
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env`:
#       cp .env.example .env
# 2. Fill in your own values (database credentials, SMTP details, etc.)
# 3. `.env` is ignored by git, so your secrets stay local. Never commit it.
#
# Values support optional double quotes: KEY="some value"
# Lines starting with # are comments. Blank lines are skipped.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="KYC Verify"
APP_URL="http://localhost/kyc-v4"
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES="5242880"

# --- Database (MySQL / MariaDB) ----------------------------------------------
DB_HOST="127.0.0.1"
DB_NAME="kyc_system"
DB_USER="root"
DB_PASS=""

# --- Email / SMTP (PHPMailer) -------------------------------------------------
# Set MAIL_ENABLED=true once you have real SMTP credentials.
# For Gmail use an App Password, not your normal account password.
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_ENCRYPTION="tls"
MAIL_FROM="no-reply@kyc.local"
MAIL_FROM_NAME="KYC Verify"
