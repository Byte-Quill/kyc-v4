# Environment & secrets - never commit real credentials
.env
.env.*
!.env.example

# Dependencies (install via `composer install`)
/vendor/
composer.phar

# Uploaded documents (keep the folder, ignore contents)
/uploads/*
!/uploads/.gitkeep

# Frontend build output & dependencies
dist/
frontend/node_modules/

# Logs & caches
*.log
.DS_Store

# IDE / OS
.idea/
.vscode/
Thumbs.db
